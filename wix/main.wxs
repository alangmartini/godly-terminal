<?xml version='1.0' encoding='windows-1252'?>
<!--
  Godly Terminal WiX installer manifest.
  Bundles all native binaries, sounds, and soundpacks into a single MSI.

  Build: pwsh scripts/production-build.ps1
-->
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <!-- ================================================================== -->
    <!-- Product definition                                                  -->
    <!-- ================================================================== -->
    <Product
        Id='*'
        Name='Godly Terminal'
        UpgradeCode='B1A2C3D4-E5F6-7890-ABCD-EF1234567890'
        Manufacturer='Godly Terminal'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='Godly Terminal — AI-native Windows terminal'
            Manufacturer='Godly Terminal'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perUser'
            SummaryCodepage='1252' />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.' />

        <MediaTemplate EmbedCab='yes' />

        <!-- ============================================================== -->
        <!-- Icon for Add/Remove Programs                                    -->
        <!-- ============================================================== -->
        <Icon Id='ProductICO' SourceFile='src-tauri\icons\icon.ico' />
        <Property Id='ARPPRODUCTICON' Value='ProductICO' />
        <Property Id='ARPHELPLINK' Value='https://github.com/alangmartini/godly-terminal' />

        <!-- ============================================================== -->
        <!-- Directory structure                                             -->
        <!-- ============================================================== -->
        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='LocalAppDataFolder'>
                <Directory Id='APPLICATIONFOLDER' Name='Godly Terminal'>
                    <Directory Id='SoundsFolder' Name='sounds' />
                    <Directory Id='SoundpacksFolder' Name='soundpacks'>
                        <Directory Id='DefaultSoundpackFolder' Name='default' />
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start Menu -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='Godly Terminal' />
            </Directory>

            <!-- Desktop -->
            <Directory Id='DesktopFolder' Name='Desktop' />
        </Directory>

        <!-- ============================================================== -->
        <!-- Main binaries component group                                   -->
        <!-- ============================================================== -->
        <DirectoryRef Id='APPLICATIONFOLDER'>
            <Component Id='MainExecutable' Guid='A1B2C3D4-1111-2222-3333-444455556666'>
                <File Id='GodlyNativeEXE'
                    Name='godly-native.exe'
                    Source='src-tauri\target\release\godly-native.exe'
                    KeyPath='yes' />
            </Component>

            <Component Id='DaemonBinary' Guid='A1B2C3D4-1111-2222-3333-444455557777'>
                <File Id='GodlyDaemonEXE'
                    Name='godly-daemon.exe'
                    Source='src-tauri\target\release\godly-daemon.exe'
                    KeyPath='yes' />
            </Component>

            <Component Id='McpBinary' Guid='A1B2C3D4-1111-2222-3333-444455558888'>
                <File Id='GodlyMcpEXE'
                    Name='godly-mcp.exe'
                    Source='src-tauri\target\release\godly-mcp.exe'
                    KeyPath='yes' />
            </Component>

            <Component Id='NotifyBinary' Guid='A1B2C3D4-1111-2222-3333-444455559999'>
                <File Id='GodlyNotifyEXE'
                    Name='godly-notify.exe'
                    Source='src-tauri\target\release\godly-notify.exe'
                    KeyPath='yes' />
            </Component>

            <Component Id='PtyShimBinary' Guid='A1B2C3D4-1111-2222-3333-44445555AAAA'>
                <File Id='GodlyPtyShimEXE'
                    Name='godly-pty-shim.exe'
                    Source='src-tauri\target\release\godly-pty-shim.exe'
                    KeyPath='yes' />
            </Component>

            <Component Id='RemoteBinary' Guid='A1B2C3D4-1111-2222-3333-44445555BBBB'>
                <File Id='GodlyRemoteEXE'
                    Name='godly-remote.exe'
                    Source='src-tauri\target\release\godly-remote.exe'
                    KeyPath='yes' />
            </Component>

            <Component Id='TmuxShimBinary' Guid='A1B2C3D4-1111-2222-3333-44445555FF22'>
                <File Id='TmuxShimEXE'
                    Name='tmux.exe'
                    Source='src-tauri\target\release\tmux.exe'
                    KeyPath='yes' />
            </Component>

            <Component Id='IconFile' Guid='A1B2C3D4-1111-2222-3333-44445555CCCC'>
                <File Id='AppIcon'
                    Name='icon.ico'
                    Source='src-tauri\icons\icon.ico'
                    KeyPath='yes' />
            </Component>
        </DirectoryRef>

        <!-- ============================================================== -->
        <!-- Sounds                                                          -->
        <!-- ============================================================== -->
        <DirectoryRef Id='SoundsFolder'>
            <Component Id='SoundFiles' Guid='A1B2C3D4-1111-2222-3333-44445555DDDD'>
                <File Id='WorkCompleteMP3'
                    Name='work_complete.mp3'
                    Source='src-tauri\sounds\work_complete.mp3'
                    KeyPath='yes' />
            </Component>
        </DirectoryRef>

        <!-- ============================================================== -->
        <!-- Default soundpack                                               -->
        <!-- ============================================================== -->
        <DirectoryRef Id='DefaultSoundpackFolder'>
            <Component Id='DefaultSoundpack' Guid='A1B2C3D4-1111-2222-3333-44445555EEEE'>
                <File Id='SP_manifest' Name='manifest.json' Source='src-tauri\soundpacks\default\manifest.json' KeyPath='yes' />
                <File Id='SP_PeonAngry1' Name='PeonAngry1.wav' Source='src-tauri\soundpacks\default\PeonAngry1.wav' />
                <File Id='SP_PeonAngry2' Name='PeonAngry2.wav' Source='src-tauri\soundpacks\default\PeonAngry2.wav' />
                <File Id='SP_PeonAngry3' Name='PeonAngry3.wav' Source='src-tauri\soundpacks\default\PeonAngry3.wav' />
                <File Id='SP_PeonAngry4' Name='PeonAngry4.wav' Source='src-tauri\soundpacks\default\PeonAngry4.wav' />
                <File Id='SP_PeonDeath' Name='PeonDeath.wav' Source='src-tauri\soundpacks\default\PeonDeath.wav' />
                <File Id='SP_PeonReady1' Name='PeonReady1.wav' Source='src-tauri\soundpacks\default\PeonReady1.wav' />
                <File Id='SP_PeonWarcry1' Name='PeonWarcry1.wav' Source='src-tauri\soundpacks\default\PeonWarcry1.wav' />
                <File Id='SP_PeonWhat1' Name='PeonWhat1.wav' Source='src-tauri\soundpacks\default\PeonWhat1.wav' />
                <File Id='SP_PeonWhat2' Name='PeonWhat2.wav' Source='src-tauri\soundpacks\default\PeonWhat2.wav' />
                <File Id='SP_PeonWhat3' Name='PeonWhat3.wav' Source='src-tauri\soundpacks\default\PeonWhat3.wav' />
                <File Id='SP_PeonWhat4' Name='PeonWhat4.wav' Source='src-tauri\soundpacks\default\PeonWhat4.wav' />
                <File Id='SP_PeonYes1' Name='PeonYes1.wav' Source='src-tauri\soundpacks\default\PeonYes1.wav' />
                <File Id='SP_PeonYes2' Name='PeonYes2.wav' Source='src-tauri\soundpacks\default\PeonYes2.wav' />
                <File Id='SP_PeonYes3' Name='PeonYes3.wav' Source='src-tauri\soundpacks\default\PeonYes3.wav' />
                <File Id='SP_PeonYes4' Name='PeonYes4.wav' Source='src-tauri\soundpacks\default\PeonYes4.wav' />
                <File Id='SP_PeonYesAttack1' Name='PeonYesAttack1.wav' Source='src-tauri\soundpacks\default\PeonYesAttack1.wav' />
                <File Id='SP_PeonYesAttack2' Name='PeonYesAttack2.wav' Source='src-tauri\soundpacks\default\PeonYesAttack2.wav' />
                <File Id='SP_PeonYesAttack3' Name='PeonYesAttack3.wav' Source='src-tauri\soundpacks\default\PeonYesAttack3.wav' />
            </Component>
        </DirectoryRef>

        <!-- ============================================================== -->
        <!-- Start Menu shortcut                                             -->
        <!-- ============================================================== -->
        <DirectoryRef Id='ApplicationProgramsFolder'>
            <Component Id='ApplicationShortcut' Guid='A1B2C3D4-1111-2222-3333-44445555FF00'>
                <Shortcut Id='ApplicationStartMenuShortcut'
                    Name='Godly Terminal'
                    Description='AI-native Windows terminal'
                    Target='[APPLICATIONFOLDER]godly-native.exe'
                    WorkingDirectory='APPLICATIONFOLDER'
                    Icon='ProductICO' />
                <RemoveFolder Id='CleanUpShortcutFolder'
                    Directory='ApplicationProgramsFolder'
                    On='uninstall' />
                <RegistryValue Root='HKCU'
                    Key='Software\GodlyTerminal'
                    Name='installed'
                    Type='integer'
                    Value='1'
                    KeyPath='yes' />
            </Component>
        </DirectoryRef>

        <!-- ============================================================== -->
        <!-- Desktop shortcut                                                -->
        <!-- ============================================================== -->
        <DirectoryRef Id='DesktopFolder'>
            <Component Id='DesktopShortcut' Guid='A1B2C3D4-1111-2222-3333-44445555FF11'>
                <Shortcut Id='DesktopShortcutLink'
                    Name='Godly Terminal'
                    Description='AI-native Windows terminal'
                    Target='[APPLICATIONFOLDER]godly-native.exe'
                    WorkingDirectory='APPLICATIONFOLDER'
                    Icon='ProductICO' />
                <RegistryValue Root='HKCU'
                    Key='Software\GodlyTerminal'
                    Name='desktopShortcut'
                    Type='integer'
                    Value='1'
                    KeyPath='yes' />
            </Component>
        </DirectoryRef>

        <!-- ============================================================== -->
        <!-- Feature tree                                                    -->
        <!-- ============================================================== -->
        <Feature Id='Binaries' Title='Godly Terminal' Level='1'>
            <ComponentRef Id='MainExecutable' />
            <ComponentRef Id='DaemonBinary' />
            <ComponentRef Id='McpBinary' />
            <ComponentRef Id='NotifyBinary' />
            <ComponentRef Id='PtyShimBinary' />
            <ComponentRef Id='RemoteBinary' />
            <ComponentRef Id='TmuxShimBinary' />
            <ComponentRef Id='IconFile' />
            <ComponentRef Id='SoundFiles' />
            <ComponentRef Id='DefaultSoundpack' />
            <ComponentRef Id='ApplicationShortcut' />
            <ComponentRef Id='DesktopShortcut' />
        </Feature>

    </Product>
</Wix>
