{
  "id": "workspace-switch",
  "description": "Create a second workspace, switch between workspaces, verify active workspace changes.",
  "frontends": ["web", "native"],
  "fixture": "clean-profile",
  "requires_restart": false,
  "steps": [
    {
      "id": "get-initial-workspace",
      "description": "Record the initial active workspace",
      "type": "query",
      "target": "workspace.active"
    },
    {
      "id": "create-workspace",
      "description": "Create a second workspace",
      "type": "action",
      "target": "workspace",
      "action": "create",
      "args": { "name": "Test Workspace 2" }
    },
    {
      "id": "verify-workspace-list",
      "description": "Verify two workspaces exist",
      "type": "query",
      "target": "workspace.list",
      "assertions": [
        { "id": "has-two-workspaces", "type": "gt", "path": "length", "expected": 1 }
      ]
    },
    {
      "id": "switch-workspace",
      "description": "Switch to the new workspace",
      "type": "action",
      "target": "workspace",
      "action": "switch",
      "args": { "use_last": true }
    },
    {
      "id": "verify-switched",
      "description": "Verify active workspace changed",
      "type": "wait",
      "condition": "workspace.switched",
      "timeout_ms": 3000
    }
  ],
  "cleanup": [
    { "type": "action", "target": "workspace", "action": "delete", "args": { "use_last": true } }
  ]
}
