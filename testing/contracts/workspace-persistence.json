{
  "id": "workspace-persistence",
  "description": "Verify workspace names, terminal counts, and active workspace survive an app restart.",
  "frontends": ["web", "native"],
  "fixture": "multi-workspace",
  "requires_restart": true,
  "steps": [
    {
      "id": "verify-workspace-count",
      "description": "Confirm two workspaces exist before restart",
      "type": "query",
      "target": "workspace.list",
      "assertions": [
        { "id": "two-workspaces", "type": "equals", "path": "length", "expected": 2 }
      ]
    },
    {
      "id": "verify-terminal-count",
      "description": "Default workspace should have 2 terminals",
      "type": "query",
      "target": "terminal.count",
      "assertions": [
        { "id": "two-terminals", "type": "equals", "expected": 2 }
      ]
    },
    {
      "id": "record-active-workspace",
      "description": "Record which workspace is active before restart",
      "type": "query",
      "target": "workspace.active"
    },
    {
      "id": "save-layout",
      "description": "Trigger layout save before restart",
      "type": "action",
      "target": "app",
      "action": "save_layout"
    },
    {
      "id": "restart-app",
      "description": "Gracefully restart the staging app",
      "type": "action",
      "target": "app.lifecycle",
      "action": "restart"
    },
    {
      "id": "wait-app-ready",
      "description": "Wait for app to be ready after restart",
      "type": "wait",
      "condition": "app.ready",
      "timeout_ms": 30000
    },
    {
      "id": "verify-workspaces-restored",
      "description": "Both workspaces should still exist after restart",
      "type": "query",
      "target": "workspace.list",
      "assertions": [
        { "id": "workspaces-restored", "type": "equals", "path": "length", "expected": 2 }
      ]
    },
    {
      "id": "verify-workspace-names",
      "description": "The second workspace should retain its name",
      "type": "query",
      "target": "workspace.list",
      "assertions": [
        { "id": "persist-ws-name", "type": "contains", "path": "[*].name", "expected": "Persist WS" }
      ]
    },
    {
      "id": "verify-active-workspace-restored",
      "description": "Active workspace should be the same as before restart",
      "type": "query",
      "target": "workspace.active",
      "assertions": [
        { "id": "active-ws-same", "type": "not_null" }
      ]
    },
    {
      "id": "verify-terminals-restored",
      "description": "Default workspace should still have 2 terminals",
      "type": "query",
      "target": "terminal.count",
      "assertions": [
        { "id": "terminals-restored", "type": "equals", "expected": 2 }
      ]
    },
    {
      "id": "switch-to-second-workspace",
      "description": "Switch to the second workspace to verify its terminals",
      "type": "action",
      "target": "workspace",
      "action": "switch",
      "args": { "name": "Persist WS" }
    },
    {
      "id": "wait-workspace-switched",
      "description": "Wait for workspace switch to complete",
      "type": "wait",
      "condition": "workspace.switched",
      "timeout_ms": 5000
    },
    {
      "id": "verify-second-ws-terminals",
      "description": "Second workspace should have 1 terminal after restart",
      "type": "query",
      "target": "terminal.count",
      "assertions": [
        { "id": "second-ws-terminal", "type": "equals", "expected": 1 }
      ]
    }
  ],
  "cleanup": [
    { "type": "reset" }
  ]
}
