{
  "id": "terminal-crud",
  "description": "Create a terminal, verify it exists, rename it, and close it.",
  "frontends": ["web", "native"],
  "fixture": "clean-profile",
  "requires_restart": false,
  "steps": [
    {
      "id": "create-terminal",
      "description": "Create a new terminal in active workspace",
      "type": "action",
      "target": "terminal",
      "action": "create"
    },
    {
      "id": "wait-terminal-ready",
      "description": "Wait for terminal to be created and ready",
      "type": "wait",
      "condition": "terminal.created",
      "timeout_ms": 5000
    },
    {
      "id": "verify-terminal-exists",
      "description": "Query terminal count to verify creation",
      "type": "query",
      "target": "terminal.count",
      "assertions": [
        { "id": "terminal-created", "type": "gt", "expected": 0 }
      ]
    },
    {
      "id": "close-terminal",
      "description": "Close the created terminal",
      "type": "action",
      "target": "terminal",
      "action": "close",
      "args": { "use_active": true }
    }
  ],
  "cleanup": [
    { "type": "reset" }
  ]
}
