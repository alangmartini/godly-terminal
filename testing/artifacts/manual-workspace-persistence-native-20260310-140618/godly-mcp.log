utually exclusive with cwd.","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"create_terminal"},{"description":"Close a terminal by its ID","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to close","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"close_terminal"},{"description":"Rename a terminal tab","inputSchema":{"properties":{"name":{"description":"New name for the terminal tab","type":"string"},"terminal_id":{"description":"ID of the terminal to rename","type":"string"}},"required":["terminal_id","name"],"type":"object"},"name":"rename_terminal"},{"description":"Switch the active tab to a specific terminal","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to focus","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"focus_terminal"},{"description":"List all workspaces with IDs, names, and folder paths","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_workspaces"},{"description":"Create a new workspace","inputSchema":{"properties":{"folder_path":{"description":"Folder path for the workspace","type":"string"},"name":{"description":"Name for the new workspace","type":"string"}},"required":["name","folder_path"],"type":"object"},"name":"create_workspace"},{"description":"Switch the active workspace","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to switch to","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"switch_workspace"},{"description":"Rename a workspace","inputSchema":{"properties":{"name":{"description":"New name for the workspace","type":"string"},"workspace_id":{"description":"ID of the workspace to rename","type":"string"}},"required":["workspace_id","name"],"type":"object"},"name":"rename_workspace"},{"description":"Reorder workspaces in the sidebar. Pass the full list of workspace IDs in the desired order. Unknown IDs are ignored; any existing workspaces not in the list are appended at the end.","inputSchema":{"properties":{"workspace_ids":{"description":"Ordered list of workspace IDs","items":{"type":"string"},"type":"array"}},"required":["workspace_ids"],"type":"object"},"name":"reorder_workspaces"},{"description":"Get detailed information about a workspace including name, folder path, worktree mode, claude code mode, and terminal count.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_workspace_details"},{"description":"Open a file or folder path in Windows Explorer.","inputSchema":{"properties":{"path":{"description":"File or folder path to open in Explorer","type":"string"}},"required":["path"],"type":"object"},"name":"open_in_explorer"},{"description":"Move a terminal to a different workspace","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to move","type":"string"},"workspace_id":{"description":"ID of the target workspace","type":"string"}},"required":["terminal_id","workspace_id"],"type":"object"},"name":"move_terminal_to_workspace"},{"description":"Send raw text input to a terminal. Does NOT append a newline — include \\n in the data to press Enter.\n\nBest practices:\n- For running commands and reading output, prefer `execute_command` (single tool call instead of 3).\n- For special keys (Ctrl+C, arrows), use `send_keys` instead.\n- Use this tool for interactive input, partial typing, or streaming text that doesn't need output capture.","inputSchema":{"properties":{"data":{"description":"Text to send to the terminal. Newlines (\\n) are converted to Enter (CR).","type":"string"},"focus":{"description":"Whether to auto-focus the terminal in the UI. Default: false.","type":"boolean"},"terminal_id":{"description":"ID of the terminal to write to","type":"string"}},"required":["terminal_id","data"],"type":"object"},"name":"write_to_terminal"},{"description":"Read raw output from a terminal's rolling 1MB buffer.\n\nBest practices:\n- For running a command and reading its output, prefer `execute_command` (single tool call).\n- Use `read_terminal` when you need historical output, not just the result of the last command.\n- Default mode is 'tail' (last 100 lines). Use strip_ansi=true for clean text.","inputSchema":{"properties":{"filename":{"description":"Save output to file instead of returning it in the response.","type":"string"},"lines":{"default":100,"description":"Number of lines to return (default: 100). Ignored when mode is 'full'.","type":"number"},"mode":{"default":"tail","description":"Output mode: 'full' returns entire buffer, 'head' returns first N lines, 'tail' (default) returns last N lines","enum":["full","head","tail"],"type":"string"},"strip_ansi":{"description":"Strip ANSI escape codes from the output for clean plain-text. Default: false.","type":"boolean"},"terminal_id":{"description":"ID of the terminal to read from","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"read_terminal"},{"description":"Resize the terminal PTY dimensions","inputSchema":{"properties":{"cols":{"description":"Number of columns","type":"number"},"rows":{"description":"Number of rows","type":"number"},"terminal_id":{"description":"ID of the terminal to resize","type":"string"}},"required":["terminal_id","rows","cols"],"type":"object"},"name":"resize_terminal"},{"description":"Delete a workspace and close all its terminals","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to delete","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"delete_workspace"},{"description":"Get the currently active workspace","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_active_workspace"},{"description":"Get the currently focused terminal","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_active_terminal"},{"description":"Remove a git worktree by path. Useful for cleaning up worktrees created by create_terminal.","inputSchema":{"properties":{"worktree_path":{"description":"Path to the worktree to remove","type":"string"}},"required":["worktree_path"],"type":"object"},"name":"remove_worktree"},{"description":"Toggle worktree mode on/off for a workspace. When enabled, new terminals created in the workspace automatically get a git worktree.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to toggle worktree mode for","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"toggle_worktree_mode"},{"description":"Toggle Claude Code mode on/off for a workspace. When enabled, new terminals in the workspace automatically launch Claude Code.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to toggle Claude Code mode for","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"toggle_claude_code_mode"},{"description":"Get the current worktree_mode and claude_code_mode flags for a workspace.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_workspace_modes"},{"description":"Send a sound notification to alert the user. Plays a chime and shows a badge on the terminal tab if the user isn't looking at it.","inputSchema":{"properties":{"message":{"description":"Optional message to include with the notification","type":"string"}},"required":[],"type":"object"},"name":"notify"},{"description":"Enable or disable sound notifications for a specific terminal or workspace","inputSchema":{"properties":{"enabled":{"description":"Whether notifications should be enabled","type":"boolean"},"terminal_id":{"description":"ID of the terminal to configure (optional)","type":"string"},"workspace_id":{"description":"ID of the workspace to configure (optional)","type":"string"}},"required":["enabled"],"type":"object"},"name":"set_notification_enabled"},{"description":"Check whether notifications are currently enabled for a terminal or workspace","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to check (optional)","type":"string"},"workspace_id":{"description":"ID of the workspace to check (optional)","type":"string"}},"required":[],"type":"object"},"name":"get_notification_status"},{"description":"Wait for a terminal to stop producing output (idle detection).\n\nBest practices:\n- For running a command and reading output, prefer `execute_command` (handles wait + read automatically).\n- Use `wait_for_idle` for advanced scenarios: waiting between multiple writes, monitoring long-running processes, or when you need custom idle thresholds.\n- Returns when no output for `idle_ms` milliseconds, or when timeout is reached.","inputSchema":{"properties":{"idle_ms":{"default":2000,"description":"Milliseconds of silence before considering the terminal idle (default: 2000)","type":"number"},"terminal_id":{"description":"ID of the terminal to monitor","type":"string"},"timeout_ms":{"default":30000,"description":"Maximum time to wait in milliseconds (default: 30000)","type":"number"}},"required":["terminal_id"],"type":"object"},"name":"wait_for_idle"},{"description":"Read the current visible terminal screen as parsed plain text with cursor position.\n\nBest practices:\n- Use this to check what the user sees right now (e.g., prompts, TUI apps, interactive programs).\n- For command output, prefer `execute_command` or `read_terminal` — they capture full output, not just the visible screen.\n- Returns clean text without ANSI escapes, plus cursor coordinates and screen dimensions.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to read","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"read_grid"},{"description":"Wait for specific text to appear in terminal output.\n\nBest practices:\n- Use this for waiting on specific prompts or markers (e.g., 'Build succeeded', '$ ', 'error:').\n- ANSI codes are stripped before matching. Searches the terminal's rolling 1MB output buffer.\n- Combine with `read_terminal` afterwards if you need the full output context.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to monitor","type":"string"},"text":{"description":"Text to search for in the terminal output","type":"string"},"timeout_ms":{"default":30000,"description":"Maximum time to wait in milliseconds (default: 30000)","type":"number"}},"required":["terminal_id","text"],"type":"object"},"name":"wait_for_text"},{"description":"Send special key sequences to a terminal. Use this for control keys, navigation, and signals that can't be expressed as plain text.\n\nSupported keys:\n- Control: ctrl+a through ctrl+z (ctrl+c = interrupt, ctrl+d = EOF, ctrl+z = suspend, ctrl+l = clear)\n- Navigation: up, down, left, right, home, end, pageup, pagedown\n- Editing: enter, tab, escape, backspace, delete, insert, space\n- Function: f1 through f12\n\nBest practices:\n- Send ctrl+c to interrupt a running command.\n- Send up/down to navigate shell history.\n- Send tab for shell auto-completion.\n- Multiple keys are sent in sequence (e.g., [\"up\", \"up\", \"enter\"] replays a history command).","inputSchema":{"properties":{"focus":{"description":"Whether to auto-focus the terminal in the UI. Default: false.","type":"boolean"},"keys":{"description":"Array of key names to send in sequence. Examples: [\"ctrl+c\"], [\"up\", \"enter\"], [\"tab\"]","items":{"type":"string"},"type":"array"},"terminal_id":{"description":"ID of the terminal to send keys to","type":"string"}},"required":["terminal_id","keys"],"type":"object"},"name":"send_keys"},{"description":"Erase characters from the current terminal input line by sending backspace bytes. Useful for correcting typos or clearing partial input before sending the right command.\n\nBest practices:\n- Use before `write_to_terminal` to fix a mistake without pressing Enter.\n- Only erases from the cursor position backwards — it won't erase output that has already been committed.","inputSchema":{"properties":{"count":{"default":1,"description":"Number of characters to erase (backspaces to send). Default: 1.","type":"number"},"focus":{"description":"Whether to auto-focus the terminal in the UI. Default: false.","type":"boolean"},"terminal_id":{"description":"ID of the terminal to erase content in","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"erase_content"},{"description":"Run a command in a terminal and return its output. This is the PRIMARY tool for running commands — it combines write + wait_for_idle + read into a single call, saving 2 round-trips.\n\nHow it works:\n1. Snapshots the current buffer length\n2. Writes the command + Enter\n3. Waits until the terminal is idle (no output for `idle_ms`)\n4. Reads only the NEW output (since step 1), strips ANSI codes and command echo\n5. Returns clean text output with completion status\n\nIMPORTANT — Always check the output:\n- The `output` field contains stdout AND stderr. ALWAYS read it to verify the command succeeded.\n- Look for error indicators: 'error', 'not found', 'no such file', 'permission denied', non-zero exit codes.\n- Common failure: wrong working directory. If you see path-related errors, the terminal is likely not in the project directory. Use `cd /correct/path && your_command` or create a new terminal with the `cwd` parameter.\n- If `completed` is false, the command timed out — use `read_terminal` to see full output and diagnose.\n- If `input_expected` is true, the command is waiting for your input (e.g., yes/no prompt, selection menu). Use `read_grid` to see the prompt, then `write_to_terminal` or `send_keys` to respond.\n- Do NOT fire-and-forget commands. If you run something, read the result before moving on.\n\nBest practices:\n- Use this for any command where you need the output (build, test, git, ls, etc.).\n- Use `write_to_terminal` instead for interactive programs that don't have a clear end (e.g., vim, top).\n- If the command produces output for longer than `timeout_ms`, you'll get partial output with completed=false.","inputSchema":{"properties":{"command":{"description":"The command to run (Enter is appended automatically)","type":"string"},"focus":{"description":"Whether to auto-focus the terminal in the UI. Default: false.","type":"boolean"},"idle_ms":{"default":2000,"description":"Milliseconds of silence before considering the command done (default: 2000)","type":"number"},"terminal_id":{"description":"ID of the terminal to execute in","type":"string"},"timeout_ms":{"default":30000,"description":"Maximum time to wait in milliseconds (default: 30000)","type":"number"}},"required":["terminal_id","command"],"type":"object"},"name":"execute_command"},{"description":"Spawn a new Claude Code session with a prompt. Creates a terminal with a git worktree (skipping fetch by default for speed), starts Claude Code, waits for it to be ready, and writes the prompt — all in background. Returns immediately with the terminal ID. Fire multiple calls in rapid succession for quick idea capture.\n\nThe `workspace_id` determines which workspace's folder path is used as the git repo root for worktree creation. The terminal is displayed in the Agent workspace tab.","inputSchema":{"properties":{"branch_name":{"description":"Optional custom worktree branch name (e.g. 'fix-login-bug'). Auto-generated if omitted.","type":"string"},"no_worktree":{"description":"Open in the main branch without creating a worktree (default: false). When true, branch_name and skip_fetch are ignored.","type":"boolean"},"prompt":{"description":"The prompt to send to Claude Code once it is ready","type":"string"},"skip_fetch":{"description":"Skip git fetch before creating worktree (default: true for speed). Set false to branch from latest remote state.","type":"boolean"},"workspace_id":{"description":"ID of the workspace to create the terminal in","type":"string"}},"required":["workspace_id","prompt"],"type":"object"},"name":"quick_claude"},{"description":"Create a split-pane view showing two terminals side by side in a workspace. Only one split per workspace is supported.","inputSchema":{"properties":{"direction":{"default":"horizontal","description":"Split direction: 'horizontal' for left/right, 'vertical' for top/bottom","enum":["horizontal","vertical"],"type":"string"},"left_terminal_id":{"description":"ID of the left (or top) terminal","type":"string"},"ratio":{"default":0.5,"description":"Split ratio (0.15–0.85). Default: 0.5 (equal split)","type":"number"},"right_terminal_id":{"description":"ID of the right (or bottom) terminal","type":"string"},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id","left_terminal_id","right_terminal_id"],"type":"object"},"name":"create_split"},{"description":"Remove the split-pane view from a workspace, returning to single-terminal view.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to clear split from","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"clear_split"},{"description":"Get the current split-pane configuration for a workspace. Returns the split terminals, direction, and ratio, or null if no split is active.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_split_state"},{"description":"Split an existing terminal pane to add another terminal next to it. Supports nested splits — you can split a pane that is already part of a split layout. Creates a binary tree of panes.","inputSchema":{"properties":{"direction":{"default":"horizontal","description":"Split direction: 'horizontal' for left/right, 'vertical' for top/bottom","enum":["horizontal","vertical"],"type":"string"},"new_terminal_id":{"description":"ID of the new terminal to add next to the target","type":"string"},"ratio":{"default":0.5,"description":"Split ratio (0.15–0.85). Default: 0.5 (equal split)","type":"number"},"target_terminal_id":{"description":"ID of the existing terminal pane to split","type":"string"},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id","target_terminal_id","new_terminal_id"],"type":"object"},"name":"split_terminal"},{"description":"Split YOUR OWN terminal pane to create a new terminal next to it. No IDs needed — auto-detects from GODLY_SESSION_ID. The new terminal opens in the same workspace as the calling terminal.","inputSchema":{"properties":{"command":{"description":"Command to run in the new terminal after creation (optional)","type":"string"},"cwd":{"description":"Working directory for the new terminal (optional — defaults to workspace folder)","type":"string"},"direction":{"default":"horizontal","description":"Split direction: 'horizontal' for left/right, 'vertical' for top/bottom","enum":["horizontal","vertical"],"type":"string"},"ratio":{"default":0.5,"description":"Split ratio (0.15–0.85). Default: 0.5 (equal split)","type":"number"}},"required":[],"type":"object"},"name":"self_split"},{"description":"Remove a terminal pane from the split layout. The sibling pane expands to fill the space. If only one pane remains, the layout returns to single-pane mode.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to remove from the layout","type":"string"},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id","terminal_id"],"type":"object"},"name":"unsplit_terminal"},{"description":"Get the full split layout tree for a workspace. Returns a recursive tree structure where each node is either a Leaf (containing a terminal_id) or a Split (containing direction, ratio, and two children). Returns null if the workspace has no split layout.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_layout_tree"},{"description":"Swap the positions of two terminal panes in the split layout.","inputSchema":{"properties":{"terminal_id_a":{"description":"ID of the first terminal to swap","type":"string"},"terminal_id_b":{"description":"ID of the second terminal to swap","type":"string"},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id","terminal_id_a","terminal_id_b"],"type":"object"},"name":"swap_panes"},{"description":"Zoom (maximize) a terminal pane to fill the workspace, or unzoom by passing null. The layout tree is preserved and restored when unzooming.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to zoom, or null to unzoom","type":["string","null"]},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"zoom_pane"},{"description":"Focus the adjacent pane in a split layout by direction. Moves focus left, right, up, or down from the currently active pane.","inputSchema":{"properties":{"direction":{"description":"Direction to move focus: 'left', 'right', 'up', or 'down'","enum":["left","right","up","down"],"type":"string"},"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":["direction"],"type":"object"},"name":"focus_pane"},{"description":"Focus the other pane in a 2-pane split layout. Toggles focus between the two panes. Convenient shortcut when you have exactly two panes.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":[],"type":"object"},"name":"focus_other_pane"},{"description":"Resize a split pane by adjusting the split ratio in a given direction. Moves the divider left/right or up/down by a delta amount.","inputSchema":{"properties":{"delta":{"default":0.05,"description":"Amount to adjust the ratio (default: 0.05 = 5%). Positive values move the divider in the specified direction.","type":"number"},"direction":{"description":"Direction to resize: 'left'/'right' adjusts horizontal splits, 'up'/'down' adjusts vertical splits","enum":["left","right","up","down"],"type":"string"},"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":["direction"],"type":"object"},"name":"resize_pane"},{"description":"Set the exact split ratio for the root split in a workspace. The ratio controls how space is divided between the two panes (0.0 = all first pane, 1.0 = all second pane).","inputSchema":{"properties":{"ratio":{"description":"Split ratio between 0.0 and 1.0 (clamped to 0.15–0.85)","type":"number"},"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":["ratio"],"type":"object"},"name":"set_split_ratio"},{"description":"Toggle the split direction between horizontal (left/right) and vertical (top/bottom) for the root split in a workspace.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":[],"type":"object"},"name":"rotate_split"},{"description":"Execute JavaScript in the Godly Terminal webview and return the result. The script runs in the main webview context with access to the DOM, store, and all frontend APIs. The return value is JSON-stringified. Use for DOM inspection, state queries, and UI manipulation.\n\nExamples:\n- Query store state: `return window.__STORE__.getState().splitViews`\n- Get element rect: `return document.querySelector('.split-divider')?.getBoundingClientRect()`\n- Check CSS classes: `return document.querySelector('.terminal-pane')?.className`","inputSchema":{"properties":{"script":{"description":"JavaScript code to evaluate. Use `return` for a value. Async/await is supported.","type":"string"}},"required":["script"],"type":"object"},"name":"execute_js"},{"description":"Scroll a terminal up by one page (viewport height). If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to scroll (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"scroll_page_up"},{"description":"Scroll a terminal down by one page (viewport height). If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to scroll (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"scroll_page_down"},{"description":"Scroll a terminal to the top of its scrollback history. If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to scroll (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"scroll_to_top"},{"description":"Scroll a terminal to the bottom (live output). If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to scroll (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"scroll_to_bottom"},{"description":"Get the current scroll position of a terminal, including offset, total scrollback lines, and viewport rows. If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to query (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"get_scroll_position"},{"description":"Capture a screenshot of a terminal's canvas as a PNG file. Returns the file path to the saved screenshot image. If no terminal_id is provided, captures the first visible canvas.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to screenshot (optional — captures first visible canvas if omitted)","type":"string"}},"required":[],"type":"object"},"name":"capture_screenshot"},{"description":"Get a terminal's metadata and example MCP tool calls for cross-session discovery. Useful when one Claude Code session needs to read another terminal's output.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to export info for (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"export_terminal_info"},{"description":"Switch to the next tab in tab order (wraps around to first tab after last)","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":[],"type":"object"},"name":"next_tab"},{"description":"Switch to the previous tab in tab order (wraps around to last tab before first)","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":[],"type":"object"},"name":"previous_tab"},{"description":"Switch to a specific tab by its 0-based index in the tab order","inputSchema":{"properties":{"index":{"description":"0-based index of the tab to switch to","type":"number"},"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":["index"],"type":"object"},"name":"go_to_tab"},{"description":"Reorder the terminal tabs in a workspace. Provide the full list of terminal IDs in the desired order.","inputSchema":{"properties":{"terminal_ids":{"description":"Ordered list of terminal IDs representing the new tab order","items":{"type":"string"},"type":"array"},"workspace_id":{"description":"ID of the workspace whose tabs to reorder","type":"string"}},"required":["workspace_id","terminal_ids"],"type":"object"},"name":"reorder_tabs"},{"description":"Get the current tab order (list of terminal IDs) for a workspace.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_tab_order"},{"description":"Get the current notification settings: enabled state, sound preset, and volume level.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_notification_config"},{"description":"Set the notification sound preset (e.g., 'chime', 'bell', 'ping', 'none').","inputSchema":{"properties":{"preset":{"description":"Sound preset name to use for notifications","type":"string"}},"required":["preset"],"type":"object"},"name":"set_notification_sound"},{"description":"Add a glob pattern to mute notifications for matching workspace names (e.g., 'test-*', '*-staging').","inputSchema":{"properties":{"pattern":{"description":"Glob pattern to match workspace names for muting","type":"string"}},"required":["pattern"],"type":"object"},"name":"add_mute_pattern"},{"description":"Remove a glob pattern from the notification mute list.","inputSchema":{"properties":{"pattern":{"description":"The exact glob pattern to remove","type":"string"}},"required":["pattern"],"type":"object"},"name":"remove_mute_pattern"},{"description":"List all glob patterns currently used to mute notifications for matching workspaces.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_mute_patterns"},{"description":"Open the Godly Terminal settings dialog. Optionally open to a specific tab.","inputSchema":{"properties":{"tab":{"description":"Settings tab to open to (optional — defaults to the first tab)","enum":["themes","terminal","notifications","plugins","shortcuts","remote"],"type":"string"}},"required":[],"type":"object"},"name":"open_settings"},{"description":"Force-save the current workspace and terminal layout to disk immediately. Useful after making bulk changes via MCP to ensure they persist.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"save_layout"},{"description":"Get information about the Godly Terminal app: version, workspace count, terminal count, and daemon connection status.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_app_info"},{"description":"Copy text to the system clipboard.","inputSchema":{"properties":{"text":{"description":"Text to copy to the clipboard","type":"string"}},"required":["text"],"type":"object"},"name":"copy_to_clipboard"},{"description":"Get the currently selected text in the webview. Returns the browser's text selection (if any), or an empty string if nothing is selected.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to get selection from (optional — reads browser selection if omitted)","type":"string"}},"required":[],"type":"object"},"name":"get_selected_text"},{"description":"List all available terminal themes and the currently active theme.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_themes"},{"description":"Get the name and ID of the currently active terminal theme.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_active_theme"},{"description":"Set the active terminal theme by name or ID.","inputSchema":{"properties":{"theme_name":{"description":"Name or ID of the theme to activate","type":"string"}},"required":["theme_name"],"type":"object"},"name":"set_theme"},{"description":"List all supported shell types that can be used as the default shell.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_available_shells"},{"description":"Get the current default shell configuration used for new terminals.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_default_shell"},{"description":"Set the default shell for new terminals. Use list_available_shells to see valid shell_type values. For 'wsl', optionally specify a distribution. For 'custom', provide the program path and optional args.","inputSchema":{"properties":{"custom_args":{"description":"Arguments for the custom shell program (only for shell_type='custom')","items":{"type":"string"},"type":"array"},"custom_program":{"description":"Path to shell executable (required for shell_type='custom')","type":"string"},"shell_type":{"description":"Shell type: 'windows', 'pwsh', 'cmd', 'wsl', or 'custom'","type":"string"},"wsl_distribution":{"description":"WSL distribution name (only for shell_type='wsl')","type":"string"}},"required":["shell_type"],"type":"object"},"name":"set_default_shell"},{"description":"Increase the terminal font size by 1 pixel","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"zoom_in"},{"description":"Decrease the terminal font size by 1 pixel","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"zoom_out"},{"description":"Reset the terminal font size to the default (13px)","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"zoom_reset"},{"description":"Get the current terminal font size in pixels","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_font_size"}]}}
[1772757975.253] write_message: content: {"jsonrpc":"2.0","id":1,"result":{"tools":[{"description":"Get info about the terminal Claude is running in (uses GODLY_SESSION_ID env var)","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_current_terminal"},{"description":"List all terminals with IDs, names, workspace, and process name","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_terminals"},{"description":"Create a new terminal in a workspace.\n\nThe terminal's working directory defaults to the workspace's folder path (the project directory). Pass `cwd` to override with a specific path, or use `worktree`/`worktree_name` to create a git worktree from the workspace's repo.\n\nThe `workspace_id` determines which workspace's folder path is used for CWD and worktree operations. The terminal is always displayed in the Agent workspace tab.\n\nIf you use `command` to run something at creation time, verify it succeeded by calling `read_terminal` or `execute_command` afterward — the command output is not returned inline.","inputSchema":{"properties":{"command":{"description":"A command to run in the terminal immediately after creation. A newline (Enter) is appended automatically.","type":"string"},"cwd":{"description":"Working directory for the new terminal. Defaults to the workspace's folder path if omitted. Mutually exclusive with worktree/worktree_name.","type":"string"},"focus":{"description":"Whether to auto-focus the new terminal in the UI. Default: false.","type":"boolean"},"workspace_id":{"description":"ID of the workspace to create the terminal in","type":"string"},"worktree":{"description":"Create a git worktree with an auto-generated name. The workspace must be a git repo. Mutually exclusive with cwd. Can be combined with worktree_name for a custom name.","type":"boolean"},"worktree_name":{"description":"Create a git worktree with this name and use it as the terminal's working directory. The workspace must be a git repo. Mutually exclusive with cwd.","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"create_terminal"},{"description":"Close a terminal by its ID","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to close","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"close_terminal"},{"description":"Rename a terminal tab","inputSchema":{"properties":{"name":{"description":"New name for the terminal tab","type":"string"},"terminal_id":{"description":"ID of the terminal to rename","type":"string"}},"required":["terminal_id","name"],"type":"object"},"name":"rename_terminal"},{"description":"Switch the active tab to a specific terminal","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to focus","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"focus_terminal"},{"description":"List all workspaces with IDs, names, and folder paths","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_workspaces"},{"description":"Create a new workspace","inputSchema":{"properties":{"folder_path":{"description":"Folder path for the workspace","type":"string"},"name":{"description":"Name for the new workspace","type":"string"}},"required":["name","folder_path"],"type":"object"},"name":"create_workspace"},{"description":"Switch the active workspace","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to switch to","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"switch_workspace"},{"description":"Rename a workspace","inputSchema":{"properties":{"name":{"description":"New name for the workspace","type":"string"},"workspace_id":{"description":"ID of the workspace to rename","type":"string"}},"required":["workspace_id","name"],"type":"object"},"name":"rename_workspace"},{"description":"Reorder workspaces in the sidebar. Pass the full list of workspace IDs in the desired order. Unknown IDs are ignored; any existing workspaces not in the list are appended at the end.","inputSchema":{"properties":{"workspace_ids":{"description":"Ordered list of workspace IDs","items":{"type":"string"},"type":"array"}},"required":["workspace_ids"],"type":"object"},"name":"reorder_workspaces"},{"description":"Get detailed information about a workspace including name, folder path, worktree mode, claude code mode, and terminal count.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_workspace_details"},{"description":"Open a file or folder path in Windows Explorer.","inputSchema":{"properties":{"path":{"description":"File or folder path to open in Explorer","type":"string"}},"required":["path"],"type":"object"},"name":"open_in_explorer"},{"description":"Move a terminal to a different workspace","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to move","type":"string"},"workspace_id":{"description":"ID of the target workspace","type":"string"}},"required":["terminal_id","workspace_id"],"type":"object"},"name":"move_terminal_to_workspace"},{"description":"Send raw text input to a terminal. Does NOT append a newline — include \\n in the data to press Enter.\n\nBest practices:\n- For running commands and reading output, prefer `execute_command` (single tool call instead of 3).\n- For special keys (Ctrl+C, arrows), use `send_keys` instead.\n- Use this tool for interactive input, partial typing, or streaming text that doesn't need output capture.","inputSchema":{"properties":{"data":{"description":"Text to send to the terminal. Newlines (\\n) are converted to Enter (CR).","type":"string"},"focus":{"description":"Whether to auto-focus the terminal in the UI. Default: false.","type":"boolean"},"terminal_id":{"description":"ID of the terminal to write to","type":"string"}},"required":["terminal_id","data"],"type":"object"},"name":"write_to_terminal"},{"description":"Read raw output from a terminal's rolling 1MB buffer.\n\nBest practices:\n- For running a command and reading its output, prefer `execute_command` (single tool call).\n- Use `read_terminal` when you need historical output, not just the result of the last command.\n- Default mode is 'tail' (last 100 lines). Use strip_ansi=true for clean text.","inputSchema":{"properties":{"filename":{"description":"Save output to file instead of returning it in the response.","type":"string"},"lines":{"default":100,"description":"Number of lines to return (default: 100). Ignored when mode is 'full'.","type":"number"},"mode":{"default":"tail","description":"Output mode: 'full' returns entire buffer, 'head' returns first N lines, 'tail' (default) returns last N lines","enum":["full","head","tail"],"type":"string"},"strip_ansi":{"description":"Strip ANSI escape codes from the output for clean plain-text. Default: false.","type":"boolean"},"terminal_id":{"description":"ID of the terminal to read from","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"read_terminal"},{"description":"Resize the terminal PTY dimensions","inputSchema":{"properties":{"cols":{"description":"Number of columns","type":"number"},"rows":{"description":"Number of rows","type":"number"},"terminal_id":{"description":"ID of the terminal to resize","type":"string"}},"required":["terminal_id","rows","cols"],"type":"object"},"name":"resize_terminal"},{"description":"Delete a workspace and close all its terminals","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to delete","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"delete_workspace"},{"description":"Get the currently active workspace","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_active_workspace"},{"description":"Get the currently focused terminal","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_active_terminal"},{"description":"Remove a git worktree by path. Useful for cleaning up worktrees created by create_terminal.","inputSchema":{"properties":{"worktree_path":{"description":"Path to the worktree to remove","type":"string"}},"required":["worktree_path"],"type":"object"},"name":"remove_worktree"},{"description":"Toggle worktree mode on/off for a workspace. When enabled, new terminals created in the workspace automatically get a git worktree.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to toggle worktree mode for","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"toggle_worktree_mode"},{"description":"Toggle Claude Code mode on/off for a workspace. When enabled, new terminals in the workspace automatically launch Claude Code.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to toggle Claude Code mode for","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"toggle_claude_code_mode"},{"description":"Get the current worktree_mode and claude_code_mode flags for a workspace.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_workspace_modes"},{"description":"Send a sound notification to alert the user. Plays a chime and shows a badge on the terminal tab if the user isn't looking at it.","inputSchema":{"properties":{"message":{"description":"Optional message to include with the notification","type":"string"}},"required":[],"type":"object"},"name":"notify"},{"description":"Enable or disable sound notifications for a specific terminal or workspace","inputSchema":{"properties":{"enabled":{"description":"Whether notifications should be enabled","type":"boolean"},"terminal_id":{"description":"ID of the terminal to configure (optional)","type":"string"},"workspace_id":{"description":"ID of the workspace to configure (optional)","type":"string"}},"required":["enabled"],"type":"object"},"name":"set_notification_enabled"},{"description":"Check whether notifications are currently enabled for a terminal or workspace","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to check (optional)","type":"string"},"workspace_id":{"description":"ID of the workspace to check (optional)","type":"string"}},"required":[],"type":"object"},"name":"get_notification_status"},{"description":"Wait for a terminal to stop producing output (idle detection).\n\nBest practices:\n- For running a command and reading output, prefer `execute_command` (handles wait + read automatically).\n- Use `wait_for_idle` for advanced scenarios: waiting between multiple writes, monitoring long-running processes, or when you need custom idle thresholds.\n- Returns when no output for `idle_ms` milliseconds, or when timeout is reached.","inputSchema":{"properties":{"idle_ms":{"default":2000,"description":"Milliseconds of silence before considering the terminal idle (default: 2000)","type":"number"},"terminal_id":{"description":"ID of the terminal to monitor","type":"string"},"timeout_ms":{"default":30000,"description":"Maximum time to wait in milliseconds (default: 30000)","type":"number"}},"required":["terminal_id"],"type":"object"},"name":"wait_for_idle"},{"description":"Read the current visible terminal screen as parsed plain text with cursor position.\n\nBest practices:\n- Use this to check what the user sees right now (e.g., prompts, TUI apps, interactive programs).\n- For command output, prefer `execute_command` or `read_terminal` — they capture full output, not just the visible screen.\n- Returns clean text without ANSI escapes, plus cursor coordinates and screen dimensions.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to read","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"read_grid"},{"description":"Wait for specific text to appear in terminal output.\n\nBest practices:\n- Use this for waiting on specific prompts or markers (e.g., 'Build succeeded', '$ ', 'error:').\n- ANSI codes are stripped before matching. Searches the terminal's rolling 1MB output buffer.\n- Combine with `read_terminal` afterwards if you need the full output context.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to monitor","type":"string"},"text":{"description":"Text to search for in the terminal output","type":"string"},"timeout_ms":{"default":30000,"description":"Maximum time to wait in milliseconds (default: 30000)","type":"number"}},"required":["terminal_id","text"],"type":"object"},"name":"wait_for_text"},{"description":"Send special key sequences to a terminal. Use this for control keys, navigation, and signals that can't be expressed as plain text.\n\nSupported keys:\n- Control: ctrl+a through ctrl+z (ctrl+c = interrupt, ctrl+d = EOF, ctrl+z = suspend, ctrl+l = clear)\n- Navigation: up, down, left, right, home, end, pageup, pagedown\n- Editing: enter, tab, escape, backspace, delete, insert, space\n- Function: f1 through f12\n\nBest practices:\n- Send ctrl+c to interrupt a running command.\n- Send up/down to navigate shell history.\n- Send tab for shell auto-completion.\n- Multiple keys are sent in sequence (e.g., [\"up\", \"up\", \"enter\"] replays a history command).","inputSchema":{"properties":{"focus":{"description":"Whether to auto-focus the terminal in the UI. Default: false.","type":"boolean"},"keys":{"description":"Array of key names to send in sequence. Examples: [\"ctrl+c\"], [\"up\", \"enter\"], [\"tab\"]","items":{"type":"string"},"type":"array"},"terminal_id":{"description":"ID of the terminal to send keys to","type":"string"}},"required":["terminal_id","keys"],"type":"object"},"name":"send_keys"},{"description":"Erase characters from the current terminal input line by sending backspace bytes. Useful for correcting typos or clearing partial input before sending the right command.\n\nBest practices:\n- Use before `write_to_terminal` to fix a mistake without pressing Enter.\n- Only erases from the cursor position backwards — it won't erase output that has already been committed.","inputSchema":{"properties":{"count":{"default":1,"description":"Number of characters to erase (backspaces to send). Default: 1.","type":"number"},"focus":{"description":"Whether to auto-focus the terminal in the UI. Default: false.","type":"boolean"},"terminal_id":{"description":"ID of the terminal to erase content in","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"erase_content"},{"description":"Run a command in a terminal and return its output. This is the PRIMARY tool for running commands — it combines write + wait_for_idle + read into a single call, saving 2 round-trips.\n\nHow it works:\n1. Snapshots the current buffer length\n2. Writes the command + Enter\n3. Waits until the terminal is idle (no output for `idle_ms`)\n4. Reads only the NEW output (since step 1), strips ANSI codes and command echo\n5. Returns clean text output with completion status\n\nIMPORTANT — Always check the output:\n- The `output` field contains stdout AND stderr. ALWAYS read it to verify the command succeeded.\n- Look for error indicators: 'error', 'not found', 'no such file', 'permission denied', non-zero exit codes.\n- Common failure: wrong working directory. If you see path-related errors, the terminal is likely not in the project directory. Use `cd /correct/path && your_command` or create a new terminal with the `cwd` parameter.\n- If `completed` is false, the command timed out — use `read_terminal` to see full output and diagnose.\n- If `input_expected` is true, the command is waiting for your input (e.g., yes/no prompt, selection menu). Use `read_grid` to see the prompt, then `write_to_terminal` or `send_keys` to respond.\n- Do NOT fire-and-forget commands. If you run something, read the result before moving on.\n\nBest practices:\n- Use this for any command where you need the output (build, test, git, ls, etc.).\n- Use `write_to_terminal` instead for interactive programs that don't have a clear end (e.g., vim, top).\n- If the command produces output for longer than `timeout_ms`, you'll get partial output with completed=false.","inputSchema":{"properties":{"command":{"description":"The command to run (Enter is appended automatically)","type":"string"},"focus":{"description":"Whether to auto-focus the terminal in the UI. Default: false.","type":"boolean"},"idle_ms":{"default":2000,"description":"Milliseconds of silence before considering the command done (default: 2000)","type":"number"},"terminal_id":{"description":"ID of the terminal to execute in","type":"string"},"timeout_ms":{"default":30000,"description":"Maximum time to wait in milliseconds (default: 30000)","type":"number"}},"required":["terminal_id","command"],"type":"object"},"name":"execute_command"},{"description":"Spawn a new Claude Code session with a prompt. Creates a terminal with a git worktree (skipping fetch by default for speed), starts Claude Code, waits for it to be ready, and writes the prompt — all in background. Returns immediately with the terminal ID. Fire multiple calls in rapid succession for quick idea capture.\n\nThe `workspace_id` determines which workspace's folder path is used as the git repo root for worktree creation. The terminal is displayed in the Agent workspace tab.","inputSchema":{"properties":{"branch_name":{"description":"Optional custom worktree branch name (e.g. 'fix-login-bug'). Auto-generated if omitted.","type":"string"},"no_worktree":{"description":"Open in the main branch without creating a worktree (default: false). When true, branch_name and skip_fetch are ignored.","type":"boolean"},"prompt":{"description":"The prompt to send to Claude Code once it is ready","type":"string"},"skip_fetch":{"description":"Skip git fetch before creating worktree (default: true for speed). Set false to branch from latest remote state.","type":"boolean"},"workspace_id":{"description":"ID of the workspace to create the terminal in","type":"string"}},"required":["workspace_id","prompt"],"type":"object"},"name":"quick_claude"},{"description":"Create a split-pane view showing two terminals side by side in a workspace. Only one split per workspace is supported.","inputSchema":{"properties":{"direction":{"default":"horizontal","description":"Split direction: 'horizontal' for left/right, 'vertical' for top/bottom","enum":["horizontal","vertical"],"type":"string"},"left_terminal_id":{"description":"ID of the left (or top) terminal","type":"string"},"ratio":{"default":0.5,"description":"Split ratio (0.15–0.85). Default: 0.5 (equal split)","type":"number"},"right_terminal_id":{"description":"ID of the right (or bottom) terminal","type":"string"},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id","left_terminal_id","right_terminal_id"],"type":"object"},"name":"create_split"},{"description":"Remove the split-pane view from a workspace, returning to single-terminal view.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to clear split from","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"clear_split"},{"description":"Get the current split-pane configuration for a workspace. Returns the split terminals, direction, and ratio, or null if no split is active.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_split_state"},{"description":"Split an existing terminal pane to add another terminal next to it. Supports nested splits — you can split a pane that is already part of a split layout. Creates a binary tree of panes.","inputSchema":{"properties":{"direction":{"default":"horizontal","description":"Split direction: 'horizontal' for left/right, 'vertical' for top/bottom","enum":["horizontal","vertical"],"type":"string"},"new_terminal_id":{"description":"ID of the new terminal to add next to the target","type":"string"},"ratio":{"default":0.5,"description":"Split ratio (0.15–0.85). Default: 0.5 (equal split)","type":"number"},"target_terminal_id":{"description":"ID of the existing terminal pane to split","type":"string"},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id","target_terminal_id","new_terminal_id"],"type":"object"},"name":"split_terminal"},{"description":"Split YOUR OWN terminal pane to create a new terminal next to it. No IDs needed — auto-detects from GODLY_SESSION_ID. The new terminal opens in the same workspace as the calling terminal.","inputSchema":{"properties":{"command":{"description":"Command to run in the new terminal after creation (optional)","type":"string"},"cwd":{"description":"Working directory for the new terminal (optional — defaults to workspace folder)","type":"string"},"direction":{"default":"horizontal","description":"Split direction: 'horizontal' for left/right, 'vertical' for top/bottom","enum":["horizontal","vertical"],"type":"string"},"ratio":{"default":0.5,"description":"Split ratio (0.15–0.85). Default: 0.5 (equal split)","type":"number"}},"required":[],"type":"object"},"name":"self_split"},{"description":"Remove a terminal pane from the split layout. The sibling pane expands to fill the space. If only one pane remains, the layout returns to single-pane mode.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to remove from the layout","type":"string"},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id","terminal_id"],"type":"object"},"name":"unsplit_terminal"},{"description":"Get the full split layout tree for a workspace. Returns a recursive tree structure where each node is either a Leaf (containing a terminal_id) or a Split (containing direction, ratio, and two children). Returns null if the workspace has no split layout.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_layout_tree"},{"description":"Swap the positions of two terminal panes in the split layout.","inputSchema":{"properties":{"terminal_id_a":{"description":"ID of the first terminal to swap","type":"string"},"terminal_id_b":{"description":"ID of the second terminal to swap","type":"string"},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id","terminal_id_a","terminal_id_b"],"type":"object"},"name":"swap_panes"},{"description":"Zoom (maximize) a terminal pane to fill the workspace, or unzoom by passing null. The layout tree is preserved and restored when unzooming.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to zoom, or null to unzoom","type":["string","null"]},"workspace_id":{"description":"ID of the workspace","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"zoom_pane"},{"description":"Focus the adjacent pane in a split layout by direction. Moves focus left, right, up, or down from the currently active pane.","inputSchema":{"properties":{"direction":{"description":"Direction to move focus: 'left', 'right', 'up', or 'down'","enum":["left","right","up","down"],"type":"string"},"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":["direction"],"type":"object"},"name":"focus_pane"},{"description":"Focus the other pane in a 2-pane split layout. Toggles focus between the two panes. Convenient shortcut when you have exactly two panes.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":[],"type":"object"},"name":"focus_other_pane"},{"description":"Resize a split pane by adjusting the split ratio in a given direction. Moves the divider left/right or up/down by a delta amount.","inputSchema":{"properties":{"delta":{"default":0.05,"description":"Amount to adjust the ratio (default: 0.05 = 5%). Positive values move the divider in the specified direction.","type":"number"},"direction":{"description":"Direction to resize: 'left'/'right' adjusts horizontal splits, 'up'/'down' adjusts vertical splits","enum":["left","right","up","down"],"type":"string"},"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":["direction"],"type":"object"},"name":"resize_pane"},{"description":"Set the exact split ratio for the root split in a workspace. The ratio controls how space is divided between the two panes (0.0 = all first pane, 1.0 = all second pane).","inputSchema":{"properties":{"ratio":{"description":"Split ratio between 0.0 and 1.0 (clamped to 0.15–0.85)","type":"number"},"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":["ratio"],"type":"object"},"name":"set_split_ratio"},{"description":"Toggle the split direction between horizontal (left/right) and vertical (top/bottom) for the root split in a workspace.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":[],"type":"object"},"name":"rotate_split"},{"description":"Execute JavaScript in the Godly Terminal webview and return the result. The script runs in the main webview context with access to the DOM, store, and all frontend APIs. The return value is JSON-stringified. Use for DOM inspection, state queries, and UI manipulation.\n\nExamples:\n- Query store state: `return window.__STORE__.getState().splitViews`\n- Get element rect: `return document.querySelector('.split-divider')?.getBoundingClientRect()`\n- Check CSS classes: `return document.querySelector('.terminal-pane')?.className`","inputSchema":{"properties":{"script":{"description":"JavaScript code to evaluate. Use `return` for a value. Async/await is supported.","type":"string"}},"required":["script"],"type":"object"},"name":"execute_js"},{"description":"Scroll a terminal up by one page (viewport height). If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to scroll (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"scroll_page_up"},{"description":"Scroll a terminal down by one page (viewport height). If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to scroll (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"scroll_page_down"},{"description":"Scroll a terminal to the top of its scrollback history. If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to scroll (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"scroll_to_top"},{"description":"Scroll a terminal to the bottom (live output). If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to scroll (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"scroll_to_bottom"},{"description":"Get the current scroll position of a terminal, including offset, total scrollback lines, and viewport rows. If no terminal_id is provided, uses the active terminal.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to query (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"get_scroll_position"},{"description":"Capture a screenshot of a terminal's canvas as a PNG file. Returns the file path to the saved screenshot image. If no terminal_id is provided, captures the first visible canvas.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to screenshot (optional — captures first visible canvas if omitted)","type":"string"}},"required":[],"type":"object"},"name":"capture_screenshot"},{"description":"Get a terminal's metadata and example MCP tool calls for cross-session discovery. Useful when one Claude Code session needs to read another terminal's output.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to export info for (optional — defaults to active terminal)","type":"string"}},"required":[],"type":"object"},"name":"export_terminal_info"},{"description":"Switch to the next tab in tab order (wraps around to first tab after last)","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":[],"type":"object"},"name":"next_tab"},{"description":"Switch to the previous tab in tab order (wraps around to last tab before first)","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":[],"type":"object"},"name":"previous_tab"},{"description":"Switch to a specific tab by its 0-based index in the tab order","inputSchema":{"properties":{"index":{"description":"0-based index of the tab to switch to","type":"number"},"workspace_id":{"description":"ID of the workspace (optional — defaults to active workspace)","type":"string"}},"required":["index"],"type":"object"},"name":"go_to_tab"},{"description":"Reorder the terminal tabs in a workspace. Provide the full list of terminal IDs in the desired order.","inputSchema":{"properties":{"terminal_ids":{"description":"Ordered list of terminal IDs representing the new tab order","items":{"type":"string"},"type":"array"},"workspace_id":{"description":"ID of the workspace whose tabs to reorder","type":"string"}},"required":["workspace_id","terminal_ids"],"type":"object"},"name":"reorder_tabs"},{"description":"Get the current tab order (list of terminal IDs) for a workspace.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_tab_order"},{"description":"Get the current notification settings: enabled state, sound preset, and volume level.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_notification_config"},{"description":"Set the notification sound preset (e.g., 'chime', 'bell', 'ping', 'none').","inputSchema":{"properties":{"preset":{"description":"Sound preset name to use for notifications","type":"string"}},"required":["preset"],"type":"object"},"name":"set_notification_sound"},{"description":"Add a glob pattern to mute notifications for matching workspace names (e.g., 'test-*', '*-staging').","inputSchema":{"properties":{"pattern":{"description":"Glob pattern to match workspace names for muting","type":"string"}},"required":["pattern"],"type":"object"},"name":"add_mute_pattern"},{"description":"Remove a glob pattern from the notification mute list.","inputSchema":{"properties":{"pattern":{"description":"The exact glob pattern to remove","type":"string"}},"required":["pattern"],"type":"object"},"name":"remove_mute_pattern"},{"description":"List all glob patterns currently used to mute notifications for matching workspaces.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_mute_patterns"},{"description":"Open the Godly Terminal settings dialog. Optionally open to a specific tab.","inputSchema":{"properties":{"tab":{"description":"Settings tab to open to (optional — defaults to the first tab)","enum":["themes","terminal","notifications","plugins","shortcuts","remote"],"type":"string"}},"required":[],"type":"object"},"name":"open_settings"},{"description":"Force-save the current workspace and terminal layout to disk immediately. Useful after making bulk changes via MCP to ensure they persist.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"save_layout"},{"description":"Get information about the Godly Terminal app: version, workspace count, terminal count, and daemon connection status.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_app_info"},{"description":"Copy text to the system clipboard.","inputSchema":{"properties":{"text":{"description":"Text to copy to the clipboard","type":"string"}},"required":["text"],"type":"object"},"name":"copy_to_clipboard"},{"description":"Get the currently selected text in the webview. Returns the browser's text selection (if any), or an empty string if nothing is selected.","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to get selection from (optional — reads browser selection if omitted)","type":"string"}},"required":[],"type":"object"},"name":"get_selected_text"},{"description":"List all available terminal themes and the currently active theme.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_themes"},{"description":"Get the name and ID of the currently active terminal theme.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_active_theme"},{"description":"Set the active terminal theme by name or ID.","inputSchema":{"properties":{"theme_name":{"description":"Name or ID of the theme to activate","type":"string"}},"required":["theme_name"],"type":"object"},"name":"set_theme"},{"description":"List all supported shell types that can be used as the default shell.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_available_shells"},{"description":"Get the current default shell configuration used for new terminals.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_default_shell"},{"description":"Set the default shell for new terminals. Use list_available_shells to see valid shell_type values. For 'wsl', optionally specify a distribution. For 'custom', provide the program path and optional args.","inputSchema":{"properties":{"custom_args":{"description":"Arguments for the custom shell program (only for shell_type='custom')","items":{"type":"string"},"type":"array"},"custom_program":{"description":"Path to shell executable (required for shell_type='custom')","type":"string"},"shell_type":{"description":"Shell type: 'windows', 'pwsh', 'cmd', 'wsl', or 'custom'","type":"string"},"wsl_distribution":{"description":"WSL distribution name (only for shell_type='wsl')","type":"string"}},"required":["shell_type"],"type":"object"},"name":"set_default_shell"},{"description":"Increase the terminal font size by 1 pixel","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"zoom_in"},{"description":"Decrease the terminal font size by 1 pixel","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"zoom_out"},{"description":"Reset the terminal font size to the default (13px)","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"zoom_reset"},{"description":"Get the current terminal font size in pixels","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_font_size"}]}}
