 specify a distribution. For 'custom', provide the program path and optional args.","inputSchema":{"properties":{"custom_args":{"description":"Arguments for the custom shell program (only for shell_type='custom')","items":{"type":"string"},"type":"array"},"custom_program":{"description":"Path to shell executable (required for shell_type='custom')","type":"string"},"shell_type":{"description":"Shell type: 'windows', 'pwsh', 'cmd', 'wsl', or 'custom'","type":"string"},"wsl_distribution":{"description":"WSL distribution name (only for shell_type='wsl')","type":"string"}},"required":["shell_type"],"type":"object"},"name":"set_default_shell"},{"description":"Increase the terminal font size by 1 pixel","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"zoom_in"},{"description":"Decrease the terminal font size by 1 pixel","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"zoom_out"},{"description":"Reset the terminal font size to the default (13px)","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"zoom_reset"},{"description":"Get the current terminal font size in pixels","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_font_size"}]}}
