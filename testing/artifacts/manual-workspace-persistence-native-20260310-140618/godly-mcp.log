bject"},"name":"reorder_tabs"},{"description":"Get the current tab order (list of terminal IDs) for a workspace.","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to query","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"get_tab_order"},{"description":"Get the current notification settings: enabled state, sound preset, and volume level.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"get_notification_config"},{"description":"Set the notification sound preset (e.g., 'chime', 'bell', 'ping', 'none').","inputSchema":{"properties":{"preset":{"description":"Sound preset name to use for notifications","type":"string"}},"required":["preset"],"type":"object"},"name":"set_notification_sound"},{"description":"Add a glob pattern to mute notifications for matching workspace names (e.g., 'test-*', '*-staging').","inputSchema":{"properties":{"pattern":{"description":"Glob pattern to match workspace names for muting","type":"string"}},"required":["pattern"],"type":"object"},"name":"add_mute_pattern"},{"description":"Remove a glob pattern from the notification mute list.","inputSchema":{"properties":{"pattern":{"description":"The exact glob pattern to remove","type":"string"}},"required":["pattern"],"type":"object"},"name":"remove_mute_pattern"},{"description":"List all glob patterns currently used to mute notifications for matching workspaces.","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_mute_patterns"},{"description":"Open the Godly Terminal settings dialog. Optionally open to a specific tab.","inputSchema":{"properties":{"tab":{"description":"Settings tab to open to (optional — defaults to the first tab)","enum":["themes","terminal","notifications","plugins","shortcuts","remote"],"type":"string"}},"required":[],"type":"object"},"name":"open_settings"},{"description":"Force-save the current workspace and terminal layout to disk immediately. Useful after making bulk changes 