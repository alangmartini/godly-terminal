utually exclusive with cwd.","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"create_terminal"},{"description":"Close a terminal by its ID","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to close","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"close_terminal"},{"description":"Rename a terminal tab","inputSchema":{"properties":{"name":{"description":"New name for the terminal tab","type":"string"},"terminal_id":{"description":"ID of the terminal to rename","type":"string"}},"required":["terminal_id","name"],"type":"object"},"name":"rename_terminal"},{"description":"Switch the active tab to a specific terminal","inputSchema":{"properties":{"terminal_id":{"description":"ID of the terminal to focus","type":"string"}},"required":["terminal_id"],"type":"object"},"name":"focus_terminal"},{"description":"List all workspaces with IDs, names, and folder paths","inputSchema":{"properties":{},"required":[],"type":"object"},"name":"list_workspaces"},{"description":"Create a new workspace","inputSchema":{"properties":{"folder_path":{"description":"Folder path for the workspace","type":"string"},"name":{"description":"Name for the new workspace","type":"string"}},"required":["name","folder_path"],"type":"object"},"name":"create_workspace"},{"description":"Switch the active workspace","inputSchema":{"properties":{"workspace_id":{"description":"ID of the workspace to switch to","type":"string"}},"required":["workspace_id"],"type":"object"},"name":"switch_workspace"},{"description":"Rename a workspace","inputSchema":{"properties":{"name":{"description":"New name for the workspace","type":"string"},"workspace_id":{"description":"ID of the workspace to rename","type":"string"}},"required":["workspace_id","name"],"type":"object"},"name":"rename_workspace"},{"description":"Reorder workspaces in the sidebar. Pass the full list of workspace IDs in the desired order. Unknown IDs are ignored; any existing workspaces 